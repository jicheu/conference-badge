mainmenu "Conference badge"

config BADGE_AUTO_CYCLE_MS
	int "Advance to the next page automatically every N ms (0 = off)"
	default 0
	help
	  For the simulator, where there are no physical buttons.

config BADGE_TEST_PATTERN
	bool "Show test patterns instead of the badge pages (display debugging)"
	help
	  Pages: all white, all black, orientation marker, vertical stripes.
	  Use KEY1/KEY2 to step through them.

config BADGE_PANEL_VTILED
	bool "Panel driver wants vertical 8-pixel tiles, MONO10 (Zephyr ssd16xx, 2.13\" panel)"
	help
	  Off for the 4.26" SSD1677 panel and the simulator (row-by-row, MONO01).

config BADGE_REMOTE
	bool "Accept pages sent over the console serial port (tools/send_badge.py)"
	default y
	select CRC
	help
	  Fire and forget: the page is drawn and not stored.

config BADGE_BLE
	bool "Accept pages over Bluetooth LE (Nordic UART Service)"
	depends on BT
	help
	  Needs the Bluetooth options in ble.conf (build with -DEXTRA_CONF_FILE=ble.conf).

config BADGE_BLE_PASSKEY
	int "Fixed 6-digit passkey required to connect (0 = open, no security)"
	depends on BADGE_BLE
	default 123456
	range 0 999999
	help
	  CHANGE THIS before using the badge in public: it is public in this repository.
	  With 0 anyone in radio range can overwrite the displayed page (for testing only; also
	  also remove CONFIG_BT_APP_PASSKEY from ble.conf if you want no pairing at all).

source "Kconfig.zephyr"
