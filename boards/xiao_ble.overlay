/*
 * Conference badge: XIAO nRF52840 on a Seeed XIAO ePaper Display Board EN04, with the
 * Seeed 4.26" monochrome 800x480 panel (SSD1677, ref MOB260722009) on the FPC connector.
 * Zephyr has no SSD1677 driver: src/ssd1677.c and dts/bindings/seeed,ssd1677.yaml add one.
 *
 * Pin sources
 *   - Buttons, battery sense:  Seeed wiki, "Getting Started with EN04".
 *   - Display pins:            Seeed_GFX2, src/board/configs/XIAO_ePaper_Board_Configs.h
 *                              (nrfDisplayPins()). Not documented anywhere else.
 *
 *   Signal   XIAO pad  MCU pin  Confidence
 *   CS       D7        P1.12    from library, unambiguous D-name
 *   SCK      D8        P1.13    from library, matches Zephyr xiao_spi (spi3)
 *   MOSI     D10       P1.15    from library, matches Zephyr xiao_spi (spi3)
 *   BUSY     D3        P0.29    from library, unambiguous D-name
 *   PWR_EN   D6        P1.11    from library ("enable" pin, active high)
 *   DC       D16       P0.31    library comment says "D16 (raw GPIO 35)"
 *   RST      D11       P0.15    library comment says "D11 (raw GPIO 30)"
 *
 *   DC and RST are the two to check first if the panel stays blank: confirm
 *   against the EN04 schematic (Seeed wiki, Resources) and swap here if needed.
 *
 * Panel: Seeed_GFX2 drives the 4.26" as SSD1677, 800x480, glass mirrored horizontally.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		zephyr,display = &epd;
	};

	aliases {
		sw0 = &key1;
		sw1 = &key2;
		sw2 = &key3;
	};

	/* EN04 user buttons, active low (wiki: KEY1=D1, KEY2=D2, KEY3=D4). */
	buttons {
		compatible = "gpio-keys";

		key1: key_1 {
			label = "KEY1";
			gpios = <&xiao_d 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		key2: key_2 {
			label = "KEY2";
			gpios = <&xiao_d 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};

		key3: key_3 {
			label = "KEY3";
			gpios = <&xiao_d 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_2>;
		};
	};

	mipi_dbi_epd {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&xiao_spi>;
		dc-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		epd: ssd1677@0 {
			compatible = "seeed,ssd1677"; /* out-of-tree driver: src/ssd1677.c */
			reg = <0>;
			mipi-max-frequency = <4000000>;
			width = <800>;
			height = <480>;
			/* The Seeed 4.26" glass is horizontally mirrored (Seeed_GFX2: mirror = true). */
			mirror-x;
			busy-gpios = <&xiao_d 3 GPIO_ACTIVE_HIGH>;
		};
	};
};

&xiao_spi {
	status = "okay";
	cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>;
};

/*
 * Panel power switch (EN04 "enable" net, D6 = P1.11), held on from early boot,
 * well before the display driver initializes (hog priority 41 vs display 85).
 */
&gpio1 {
	epd_power: epd-power-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "epd-power";
	};
};

/*
 * xiao_ble variant: same nRF52840 pins as the Plus board, but DC/RST (P0.31/P0.15,
 * back pads on the Plus module) are addressed as raw gpio0 pins. No vbatt node here.
 *
 * Pins shared with default XIAO peripherals that the EN04 repurposes:
 *   uart0 uses P1.11/P1.12 (D6/D7)  -> panel power / CS
 *   i2c1  uses P0.04/P0.05 (D4/D5)  -> KEY3 / battery-sense enable
 * The EN04 has its own battery divider (A0 = P0.02, enable A5 = P0.05).
 */
&uart0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};
